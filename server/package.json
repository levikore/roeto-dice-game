{
  "name": "@dice/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p .",
    "test": "vitest run --passWithNoTests --reporter=dot",
    "play-game": "node src/scripts/play-game.ts",
    "test:coverage": "vitest run --coverage --coverage.include=src/game/engine.ts --coverage.thresholds.branches=100 --coverage.thresholds.lines=100 --reporter=dot",
    "seed": "node --env-file-if-exists=../.env src/scripts/seed.ts",
    "db:reset": "rm -f dev.db dev.db-wal dev.db-shm",
    "start": "node --env-file-if-exists=../.env src/index.ts"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.4",
    "fast-check": "^4.10.2",
    "supertest": "^7.3.1"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "zod": "^4.6.7"
  }
}
